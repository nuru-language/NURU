.text

.globl _print_int
_print_int:
  push %rbp
  mov %rsp, %rbp
  sub $40, %rsp
  mov %rdi, %rax
  xor %r9, %r9
  test %rax, %rax
  jns .pi_prep
  mov $1, %r9
  neg %rax
.pi_prep:
  mov $10, %rcx
  lea 39(%rsp), %r8
  movb $0, (%r8)
.print_loop:
  xor %rdx, %rdx
  div %rcx
  add $'0', %dl
  dec %r8
  mov %dl, (%r8)
  test %rax, %rax
  jnz .print_loop
  test %r9, %r9
  jz .pi_nosign
  dec %r8
  movb $'-', (%r8)
.pi_nosign:
  lea 39(%rsp), %rsi
  sub %r8, %rsi
  mov %r8, %rdi
  call _write_string
  mov %rbp, %rsp
  pop %rbp
  ret

.globl _print_value_raw
_print_value_raw:
  mov %rax, %rdx
  and $0xff, %edx
  cmp $2, %rdx
  je .raw_int
  cmp $1, %rdx
  je .raw_bool
  cmp $4, %rdx
  je .raw_str
  cmp $0, %rdx
  je .raw_empty
  jmp .raw_int
.raw_int:
  sar $8, %rax
  mov %rax, %rdi
  call _print_int
  ret
.raw_bool:
  shr $8, %rax
  test %rax, %rax
  jz .raw_bfalse
  lea _str_true(%rip), %rdi
  mov $4, %rsi
  call _write_string
  ret
.raw_bfalse:
  lea _str_false(%rip), %rdi
  mov $5, %rsi
  call _write_string
  ret
.raw_str:
  shr $8, %rax
  mov 8(%rax), %rsi
  lea 16(%rax), %rdi
  call _write_string
  ret
.raw_empty:
  lea _str_empty(%rip), %rdi
  mov $5, %rsi
  call _write_string
  ret

.globl _print_value
_print_value:
  call _print_value_raw
  mov $1, %rax
  mov $1, %rdi
  lea _newline(%rip), %rsi
  mov $1, %rdx
  syscall
  ret

.globl _write_string
_write_string:
  mov %rdi, %r10
  mov %rsi, %rdx
  mov $1, %rdi
  mov %r10, %rsi
  mov $1, %rax
  syscall
  ret

.globl _checked_div
_checked_div:
  test %rcx, %rcx
  jz .cd_zero
  xor %rdx, %rdx
  idiv %rcx
  ret
.cd_zero:
  mov _err_jmp(%rip), %rdx
  test %rdx, %rdx
  jz .cd_crash
  jmp *%rdx
.cd_crash:
  mov $0, %rax
  ret

.globl _checked_mod
_checked_mod:
  test %rcx, %rcx
  jz .cm_zero
  xor %rdx, %rdx
  idiv %rcx
  mov %rdx, %rax
  ret
.cm_zero:
  mov _err_jmp(%rip), %rdx
  test %rdx, %rdx
  jz .cm_crash
  jmp *%rdx
.cm_crash:
  mov $0, %rax
  ret

.globl _read_line
_read_line:
  mov $528, %rdi
  call _alloc
  mov %rax, %rbx
  movq $1, (%rbx)
  lea 16(%rbx), %r12
  mov $0, %rdi
  mov %r12, %rsi
  mov $511, %rdx
  mov $0, %rax
  syscall
  cmp $0, %rax
