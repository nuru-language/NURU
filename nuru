#!/usr/bin/env bash
# Nuru command-line tool.
#
# Subcommands:
#   nuru version          show version
#   nuru build [-o OUT] FILE   compile FILE into an executable
#   nuru run FILE         compile and run FILE
#   nuru check FILE        type-check / compile FILE without emitting an exe
#   nuru clean            remove build artifacts
#   nuru help             show this help

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NURUC="${NURUC:-$ROOT/nuruc}"
VERSION="0.1.0"

usage() {
    cat <<EOF
Nuru $VERSION
Usage: nuru <command> [options] [file|dir]

Commands:
  version              Show version
  new NAME             Scaffold a new project directory
  build [-o OUT] FILE  Compile FILE into an executable (default: ./<base>)
  run FILE             Compile FILE and run it
  check FILE           Compile FILE without emitting an executable
  test [DIR]           Compile and run tests/*.nuru (compare *.expected if present)
  lock [DIR]           Write nuru.lock (resolved module graph); --check verifies
  clean                Remove build artifacts
  help                 Show this help

When FILE is a directory, the source is resolved as <dir>/src/main.nuru.
EOF
}

resolve_src() {
    local arg="$1"
    if [[ -d "$arg" ]]; then
        if [[ -f "$arg/src/main.nuru" ]]; then
            echo "$arg/src/main.nuru"
        else
            echo ""
        fi
    else
        echo "$arg"
    fi
}

manifest_name() {
    local mf="$1"
    [[ -f "$mf" ]] || return 1
    sed -n '/^\[project\]/,/^\[/p' "$mf" \
        | grep -E '^[[:space:]]*name[[:space:]]*=' \
        | head -1 \
        | sed -E 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/'
}

manifest_module_path() {
    local mf="$1"
    [[ -f "$mf" ]] || return 1
    sed -n '/^\[project\]/,/^\[/p' "$mf" \
        | grep -E '^[[:space:]]*module_path[[:space:]]*=' \
        | head -1 \
        | sed -E 's/^[[:space:]]*module_path[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/'
}

# Print "--stdlib <dir>" arguments for a project directory (if it declares a
# module_path). Caller should capture into an array.
stdlib_args_for() {
    local dir="$1"
    local mp
    mp="$(manifest_module_path "$dir/nuru.toml")"
    if [[ -n "$mp" ]]; then
        echo "--stdlib"
        echo "$dir/$mp"
    fi
}

[[ $# -ge 1 ]] || { usage; exit 1; }
cmd="$1"; shift

case "$cmd" in
    version)
        echo "nuru $VERSION"
        ;;
    help|-h|--help)
        usage
        ;;
    new)
        [[ $# -eq 1 ]] || { echo "new: expected a project name" >&2; exit 1; }
        name="$1"
        if [[ -e "$name" ]]; then
            echo "new: '$name' already exists" >&2
            exit 1
        fi
        mkdir -p "$name/src" "$name/tests" "$name/examples"
        cat > "$name/nuru.toml" <<EOF
[project]
name = "$name"
version = "0.1.0"
description = ""
EOF
        cat > "$name/src/main.nuru" <<'EOF'
create main {
    show "Hello, Nuru!"
}
EOF
        cat > "$name/README.md" <<EOF
# $name

A Nuru project.
EOF
        echo "created project '$name'"
        ;;
    lock)
        check=0
        proj="${1:-.}"
        if [[ "${1:-}" == "--check" ]]; then check=1; proj="${2:-.}"; fi
        src="$(resolve_src "$proj")"
        [[ -n "$src" ]] || { echo "lock: no src/main.nuru in '$proj'" >&2; exit 1; }
        mapfile -t stdargs < <(stdlib_args_for "$proj")
        mapfile -t cur_lines < <("$NURUC" "${stdargs[@]}" --print-imports "$src" 2>/dev/null) || {
            echo "lock: import resolution failed" >&2; exit 1; }
        lockfile="$proj/nuru.lock"
        tmp="$(mktemp)"
        for p in "${cur_lines[@]}"; do
            h="$(sha256sum "$p" 2>/dev/null | awk '{print $1}')"
            [[ -n "$h" ]] || continue
            printf '%s %s\n' "$p" "$h" >> "$tmp"
        done
        if [[ "$check" -eq 1 ]]; then
            if [[ -f "$lockfile" ]] && cmp -s "$tmp" "$lockfile"; then
                rm -f "$tmp"
                echo "locked (in sync)"
            else
                rm -f "$tmp"
                echo "lockfile out of date" >&2
                exit 1
            fi
        else
            mv "$tmp" "$lockfile"
            echo "wrote $lockfile"
        fi
        ;;
    test)
        proj="${1:-.}"
        srcdir="$proj/tests"
        if [[ ! -d "$srcdir" ]]; then
            echo "test: no tests/ directory in '$proj'" >&2
            exit 1
        fi
        tpass=0; tfail=0
        for t in "$srcdir"/*.nuru; do
            [[ -e "$t" ]] || continue
            base="$(basename "$t" .nuru)"
            tmp="$(mktemp)"
            if "$NURUC" -o "$tmp" "$t" >/dev/null 2>"$tmp.err"; then
                out="$("$tmp" 2>&1)"; status=$?
                ok=1
                if [[ -f "$srcdir/$base.expected" ]]; then
                    want="$(cat "$srcdir/$base.expected")"
                    if [[ "$out" != "$want" ]]; then ok=0; fi
                fi
                if [[ "$status" -ne 0 ]]; then ok=0; fi
                if [[ $ok -eq 1 ]]; then
                    echo "PASS  $base"; tpass=$((tpass+1))
                else
                    echo "FAIL  $base (exit $status, output: $(printf '%s' "$out" | head -c 120))"
                    tfail=$((tfail+1))
                fi
            else
                echo "FAIL  $base (compile failed: $(head -1 "$tmp.err"))"
                tfail=$((tfail+1))
            fi
            rm -f "$tmp" "$tmp.tmp" "$tmp.o" "$tmp.err"
        done
        echo "test: $tpass passed, $tfail failed"
        [[ "$tfail" -eq 0 ]]
        ;;
    clean)
        rm -rf "$ROOT/build" "$ROOT/nuruc"
        rm -f "$ROOT/examples/hello/hello" "$ROOT/examples/hello/hello.tmp"
        echo "cleaned"
        ;;
    build)
        out=""
        orig=""
        if [[ $# -ge 2 && "$1" == "-o" ]]; then
            out="$2"; shift 2
        fi
        [[ $# -eq 1 ]] || { echo "build: expected one source file" >&2; exit 1; }
        orig="$1"
        src="$(resolve_src "$orig")"
        [[ -n "$src" ]] || { echo "build: no src/main.nuru in '$orig'" >&2; exit 1; }
        if [[ -z "$out" ]]; then
            if [[ -d "$orig" ]]; then
                out="$(manifest_name "$orig/nuru.toml")"
                if [[ -n "$out" ]]; then
                    out="$orig/build/$out"
                    mkdir -p "$orig/build"
                fi
            fi
            if [[ -z "$out" ]]; then
                base="$(basename "$src")"
                out="${base%.nuru}"
            fi
        fi
        mapfile -t stdargs < <(stdlib_args_for "$orig")
        "$NURUC" "${stdargs[@]}" -o "$out" "$src" || exit $?
        rm -f "$out.tmp" "$out.o"
        ;;
    run)
        [[ $# -eq 1 ]] || { echo "run: expected one source file" >&2; exit 1; }
        orig="$1"
        src="$(resolve_src "$orig")"
        [[ -n "$src" ]] || { echo "run: no src/main.nuru in '$orig'" >&2; exit 1; }
        tmp="$(mktemp)"
        mapfile -t stdargs < <(stdlib_args_for "$orig")
        if "$NURUC" "${stdargs[@]}" -o "$tmp" "$src"; then
            "$tmp"
            status=$?
        else
            status=$?
        fi
        rm -f "$tmp" "$tmp.tmp" "$tmp.o"
        exit $status
        ;;
    check)
        [[ $# -eq 1 ]] || { echo "check: expected one source file" >&2; exit 1; }
        orig="$1"
        src="$(resolve_src "$orig")"
        [[ -n "$src" ]] || { echo "check: no src/main.nuru in '$orig'" >&2; exit 1; }
        tmp="$(mktemp)"
        mapfile -t stdargs < <(stdlib_args_for "$orig")
        if "$NURUC" "${stdargs[@]}" -o "$tmp" "$src"; then
            status=0
            echo "ok"
        else
            status=$?
        fi
        rm -f "$tmp" "$tmp.tmp" "$tmp.o"
        exit $status
        ;;
    *)
        echo "nuru: unknown command '$cmd'" >&2
        usage >&2
        exit 1
        ;;
esac
