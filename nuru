#!/usr/bin/env bash
# Nuru command-line tool.
#
# Subcommands:
#   nuru version          show version
#   nuru build [-o OUT] FILE   compile FILE into an executable
#   nuru run FILE         compile and run FILE
#   nuru check FILE        type-check / compile FILE without emitting an exe
#   nuru clean            remove build artifacts
#   nuru help             show this help

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NURUC="${NURUC:-$ROOT/nuruc}"
VERSION="0.1.0"

usage() {
    cat <<EOF
Nuru $VERSION
Usage: nuru <command> [options] [file|dir]

Commands:
  version              Show version
  new NAME             Scaffold a new project directory
  build [-o OUT] FILE  Compile FILE into an executable (default: ./<base>)
  run FILE             Compile FILE and run it
  check FILE           Compile FILE without emitting an executable
  clean                Remove build artifacts
  help                 Show this help

When FILE is a directory, the source is resolved as <dir>/src/main.nuru.
EOF
}

resolve_src() {
    local arg="$1"
    if [[ -d "$arg" ]]; then
        if [[ -f "$arg/src/main.nuru" ]]; then
            echo "$arg/src/main.nuru"
        else
            echo ""
        fi
    else
        echo "$arg"
    fi
}

[[ $# -ge 1 ]] || { usage; exit 1; }
cmd="$1"; shift

case "$cmd" in
    version)
        echo "nuru $VERSION"
        ;;
    help|-h|--help)
        usage
        ;;
    new)
        [[ $# -eq 1 ]] || { echo "new: expected a project name" >&2; exit 1; }
        name="$1"
        if [[ -e "$name" ]]; then
            echo "new: '$name' already exists" >&2
            exit 1
        fi
        mkdir -p "$name/src" "$name/tests" "$name/examples"
        cat > "$name/nuru.toml" <<EOF
[project]
name = "$name"
version = "0.1.0"
description = ""
EOF
        cat > "$name/src/main.nuru" <<'EOF'
create main {
    show "Hello, Nuru!"
}
EOF
        cat > "$name/README.md" <<EOF
# $name

A Nuru project.
EOF
        echo "created project '$name'"
        ;;
    clean)
        rm -rf "$ROOT/build" "$ROOT/nuruc"
        rm -f "$ROOT/examples/hello/hello" "$ROOT/examples/hello/hello.tmp"
        echo "cleaned"
        ;;
    build)
        out=""
        if [[ $# -ge 2 && "$1" == "-o" ]]; then
            out="$2"; shift 2
        fi
        [[ $# -eq 1 ]] || { echo "build: expected one source file" >&2; exit 1; }
        src="$(resolve_src "$1")"
        [[ -n "$src" ]] || { echo "build: no src/main.nuru in '$1'" >&2; exit 1; }
        if [[ -z "$out" ]]; then
            base="$(basename "$src")"
            out="${base%.nuru}"
        fi
        "$NURUC" -o "$out" "$src" || exit $?
        ;;
    run)
        [[ $# -eq 1 ]] || { echo "run: expected one source file" >&2; exit 1; }
        src="$(resolve_src "$1")"
        [[ -n "$src" ]] || { echo "run: no src/main.nuru in '$1'" >&2; exit 1; }
        tmp="$(mktemp)"
        if "$NURUC" -o "$tmp" "$src"; then
            "$tmp"
            status=$?
        else
            status=$?
        fi
        rm -f "$tmp" "$tmp.tmp" "$tmp.o"
        exit $status
        ;;
    check)
        [[ $# -eq 1 ]] || { echo "check: expected one source file" >&2; exit 1; }
        src="$(resolve_src "$1")"
        [[ -n "$src" ]] || { echo "check: no src/main.nuru in '$1'" >&2; exit 1; }
        tmp="$(mktemp)"
        if "$NURUC" -o "$tmp" "$src"; then
            status=0
            echo "ok"
        else
            status=$?
        fi
        rm -f "$tmp" "$tmp.tmp" "$tmp.o"
        exit $status
        ;;
    *)
        echo "nuru: unknown command '$cmd'" >&2
        usage >&2
        exit 1
        ;;
esac
