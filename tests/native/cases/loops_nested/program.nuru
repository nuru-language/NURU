create main {
    make grid be [[1, 2], [3, 4], [5, 6]]
    make s changeable 0
    for each row in grid {
        for each x in row {
            change s to s plus x
        }
    }
    show s
    make i changeable 0
    make t changeable 0
    while i is below 3 {
        make j changeable 0
        while j is below 4 {
            change t to t plus 1
            change j to j plus 1
        }
        change i to i plus 1
    }
    show t
    make u changeable 0
    repeat 3 times {
        make k changeable 0
        while k is below 2 {
            change k to k plus 1
            change u to u plus 1
        }
        change u to u plus 100
    }
    show u
}
