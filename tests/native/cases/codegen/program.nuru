# bootstrap/lexer.nuru
# Stage 1 of the self-hosted compiler: a tokenizer for Nuru source.
# Token types: 0=identifier, 1=integer, 2=string, 3=punctuation,
#              4=newline, 5=eof. Each token is a map with type/value/line.

create is_digit using c {
    when c is at least 48 {
        when c is at most 57 {
            give 1
        }
    }
    give 0
}

create is_alpha using c {
    when c is at least 65 {
        when c is at most 90 {
            give 1
        }
    }
    when c is at least 97 {
        when c is at most 122 {
            give 1
        }
    }
    when c is 95 {
        give 1
    }
    give 0
}

create make_token using t, v, ln {
    give map [ type is t, value is v, line is ln ]
}

create lex using src {
    make tokens be []
    make i changeable 0
    make n be len with src
    make line changeable 1

    while i is below n {
        make c be ord with substring with src, i, i plus 1

        when c is 10 {
            add make_token with 4, "", line to tokens
            change line to line plus 1
            change i to i plus 1
        }
        otherwise {
            when c is 32 {
                change i to i plus 1
            }
            otherwise {
                when c is 9 {
                    change i to i plus 1
                }
                otherwise {
                    when (is_digit with c) is 1 {
                        make start be i
                        while i is below n {
                            make c2 be ord with substring with src, i, i plus 1
                            when (is_digit with c2) is 1 {
                                change i to i plus 1
                            }
                            otherwise {
                                stop
                            }
                        }
                        make sv_int be substring with src, start, i
                        make nv be to_number with sv_int
                        add make_token with 1, nv, line to tokens
                    }
                    otherwise {
                        when (is_alpha with c) is 1 {
                            make start be i
                            while i is below n {
                                make c2 be ord with substring with src, i, i plus 1
                                when (is_alpha with c2) is 1 {
                                    change i to i plus 1
                                }
                                otherwise {
                                    stop
                                }
                            }
                            make sv_id be substring with src, start, i
                            add make_token with 0, sv_id, line to tokens
                        }
                        otherwise {
                            when c is 34 {
                                make start be i
                                change i to i plus 1
                                make kg changeable 1
                                while kg is 1 {
                                    when i is at least n {
                                        change kg to 0
                                    }
                                    otherwise {
                                        make c2 be ord with substring with src, i, i plus 1
                                        when c2 is 34 {
                                            change i to i plus 1
                                            change kg to 0
                                        }
                                        otherwise {
                                            change i to i plus 1
                                        }
                                    }
                                }
                                make sv_str be substring with src, start, i
                                add make_token with 2, sv_str, line to tokens
                            }
                            otherwise {
                                make cv_punct be chr with c
                                add map [ type is 3, value is cv_punct, code is c, line is line ] to tokens
                                change i to i plus 1
                            }
                        }
                    }
                }
            }
        }
    }

    add make_token with 5, "", line to tokens
    give tokens
}

# bootstrap/parser_expr.nuru
# Stage 2 (subset): a recursive-descent expression parser written in Nuru.
# Parses integer/identifier primaries and + - * / with parentheses into a
# nested map-based AST (kind: "int" / "id" / "binop").

create parse_list_literal using toks, p {
    make items be []
    make q changeable p plus 1
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", code is 0, line is 0 ]
    while go is 1 {
        when q is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[q]
            when tok.code is 93 {
                make li1 be map [ kind is "list", items is items ]
                give map [ node is li1, pos is q plus 1 ]
            }
            otherwise {
                make r be parse_expr with toks, q
                add r.node to items
                change q to r.pos
                when q is below L {
                    change tok to toks[q]
                    when tok.code is 44 {
                        change q to q plus 1
                    }
                }
            }
        }
    }
    make li2 be map [ kind is "list", items is items ]
    give map [ node is li2, pos is p plus 1 ]
}

create parse_map_literal using toks, p {
    make entries be []
    make q changeable p plus 2
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", code is 0, line is 0 ]
    while go is 1 {
        when q is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[q]
            when tok.code is 93 {
                make mk1 be map [ kind is "map", entries is entries ]
                give map [ node is mk1, pos is q plus 1 ]
            }
            otherwise {
                make ktok be toks[q]
                make r be parse_expr with toks, q plus 2
                make en be map [ key is ktok.value, value is r.node ]
                add en to entries
                change q to r.pos
                when q is below L {
                    change tok to toks[q]
                    when tok.code is 44 {
                        change q to q plus 1
                    }
                }
            }
        }
    }
    make mk2 be map [ kind is "map", entries is entries ]
    give map [ node is mk2, pos is p plus 1 ]
}

create parse_primary using toks, p {
    make tok be toks[p]
    when tok.type is 1 {
        give map [ node is map [ kind is "int", value is tok.value ], pos is p plus 1 ]
    }
    otherwise {
        when tok.type is 0 {
            when (tok_is with tok, "map") is 1 {
                give parse_map_literal with toks, p
            }
            otherwise {
                make L2 be len with toks
                when (p plus 1) is below L2 {
                    make nxt be toks[p plus 1]
                    when nxt.type is 0 {
                        when (str_eq with nxt.value, "with") is 1 {
                            make args be []
                            make q changeable p plus 2
                            make go changeable 1
                            make tcur changeable map [ type is 0, value is "", code is 0, line is 0 ]
                            while go is 1 {
                                when q is at least L2 {
                                    change go to 0
                                }
                                otherwise {
                                    make r be parse_expr with toks, q
                                    add r.node to args
                                    change q to r.pos
                                    when q is below L2 {
                                        change tcur to toks[q]
                                        when tcur.code is 44 {
                                            change q to q plus 1
                                        }
                                        otherwise {
                                            change go to 0
                                        }
                                    }
                                    otherwise {
                                        change go to 0
                                    }
                                }
                            }
                            make call1 be map [ kind is "call", name is tok.value, args is args ]
                            give map [ node is call1, pos is q ]
                        }
                    }
                }
                give map [ node is map [ kind is "id", value is tok.value ], pos is p plus 1 ]
            }
        }
        otherwise {
            when tok.type is 2 {
                give map [ node is map [ kind is "str", value is tok.value ], pos is p plus 1 ]
            }
            otherwise {
                when tok.type is 3 {
                    when tok.code is 40 {
                        make r be parse_expr with toks, p plus 1
                        give map [ node is r.node, pos is r.pos plus 1 ]
                    }
                    otherwise {
                        when tok.code is 91 {
                            give parse_list_literal with toks, p
                        }
                        otherwise {
                            give map [ node is map [ kind is "err", value is "" ], pos is p plus 1 ]
                        }
                    }
                }
                otherwise {
                    give map [ node is map [ kind is "err", value is "" ], pos is p plus 1 ]
                }
            }
        }
    }
}

create str_eq using a, b {
    make la be len with a
    make lb be len with b
    when la is not lb {
        give 0
    }
    make i changeable 0
    while i is below la {
        make ca be ord with substring with a, i, i plus 1
        make cb be ord with substring with b, i, i plus 1
        when ca is not cb {
            give 0
        }
        change i to i plus 1
    }
    give 1
}

create tok_is using tok, w {
    when tok.type is 0 {
        give str_eq with tok.value, w
    }
    give 0
}

create parse_mul using toks, p {
    make prim be parse_primary with toks, p
    make l changeable prim.node
    make n changeable prim.pos
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", line is 0 ]
    while go is 1 {
        when n is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[n]
            when tok.type is 3 {
                when tok.code is 42 {
                    make r be parse_primary with toks, n plus 1
                    make rn be r.node
                    change n to r.pos
                    change l to map [ kind is "binop", op is "*", left is l, right is rn ]
                }
                otherwise {
                    when tok.code is 47 {
                        make r be parse_primary with toks, n plus 1
                        make rn be r.node
                        change n to r.pos
                        change l to map [ kind is "binop", op is "/", left is l, right is rn ]
                    }
                    otherwise {
                        change go to 0
                    }
                }
            }
            otherwise {
                when (tok_is with tok, "times") is 1 {
                    make r be parse_primary with toks, n plus 1
                    make rn be r.node
                    change n to r.pos
                    change l to map [ kind is "binop", op is "times", left is l, right is rn ]
                }
                otherwise {
                    change go to 0
                }
            }
        }
    }
    give map [ node is l, pos is n ]
}

create parse_add using toks, p {
    make prim be parse_mul with toks, p
    make l changeable prim.node
    make n changeable prim.pos
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", line is 0 ]
    while go is 1 {
        when n is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[n]
            when tok.type is 3 {
                when tok.code is 43 {
                    make r be parse_mul with toks, n plus 1
                    make rn be r.node
                    change n to r.pos
                    change l to map [ kind is "binop", op is "+", left is l, right is rn ]
                }
                otherwise {
                    when tok.code is 45 {
                        make r be parse_mul with toks, n plus 1
                        make rn be r.node
                        change n to r.pos
                        change l to map [ kind is "binop", op is "-", left is l, right is rn ]
                    }
                    otherwise {
                        change go to 0
                    }
                }
            }
            otherwise {
                when (tok_is with tok, "plus") is 1 {
                    make r be parse_mul with toks, n plus 1
                    make rn be r.node
                    change n to r.pos
                    change l to map [ kind is "binop", op is "plus", left is l, right is rn ]
                }
                otherwise {
                    when (tok_is with tok, "minus") is 1 {
                        make r be parse_mul with toks, n plus 1
                        make rn be r.node
                        change n to r.pos
                        change l to map [ kind is "binop", op is "minus", left is l, right is rn ]
                    }
                    otherwise {
                        change go to 0
                    }
                }
            }
        }
    }
    give map [ node is l, pos is n ]
}

create parse_comparison using toks, p {
    make prim be parse_add with toks, p
    make l changeable prim.node
    make n changeable prim.pos
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", code is 0, line is 0 ]
    while go is 1 {
        when n is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[n]
            when tok.type is 0 {
                when (str_eq with tok.value, "is") is 1 {
                    make op changeable "is"
                    make m changeable n plus 1
                    make consumed changeable 0
                    when m is below L {
                        make t2 be toks[m]
                        when t2.type is 0 {
                            when (str_eq with t2.value, "not") is 1 {
                                change op to "is not"
                                change m to m plus 1
                                change consumed to 1
                            }
                            otherwise {
                                when (str_eq with t2.value, "above") is 1 {
                                    change op to "is above"
                                    change m to m plus 1
                                    change consumed to 1
                                }
                                otherwise {
                                    when (str_eq with t2.value, "below") is 1 {
                                        change op to "is below"
                                        change m to m plus 1
                                        change consumed to 1
                                    }
                                    otherwise {
                                        when (str_eq with t2.value, "at") is 1 {
                                            when (m plus 1) is below L {
                                                make t3 be toks[m plus 1]
                                                when t3.type is 0 {
                                                    when (str_eq with t3.value, "least") is 1 {
                                                        change op to "is at least"
                                                        change m to m plus 2
                                                        change consumed to 1
                                                    }
                                                    otherwise {
                                                        when (str_eq with t3.value, "most") is 1 {
                                                            change op to "is at most"
                                                            change m to m plus 2
                                                            change consumed to 1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    make r be parse_add with toks, m
                    make rn be r.node
                    change n to r.pos
                    change l to map [ kind is "cmp", op is op, left is l, right is rn ]
                }
                otherwise {
                    change go to 0
                }
            }
            otherwise {
                change go to 0
            }
        }
    }
    give map [ node is l, pos is n ]
}

create parse_expr using toks, p {
    give parse_comparison with toks, p
}

create show_ast using node, depth {
    make indent changeable ""
    make i changeable 0
    while i is below depth {
        change indent to concat with indent, "  "
        change i to i plus 1
    }
    make line be concat with indent, node.kind
    show line
    when node.kind is "binop" {
        make t1 be concat with indent, "op="
        make t2 be concat with t1, node.op
        show t2
        show_ast with node.left, depth plus 1
        show_ast with node.right, depth plus 1
    }
    otherwise {
        when node.kind is "id" {
            make t3 be concat with indent, node.value
            show t3
        }
        otherwise {
            when node.kind is "int" {
                make t4 be concat with indent, to_string with node.value
                show t4
            }
        }
    }
}

create parse_while using toks, p {
    make c be parse_expr with toks, p plus 1
    make q changeable c.pos
    make tb be parse_block with toks, q
    make r1 be map [ kind is "while", cond is c.node, body is tb.block ]
    give map [ stmt is r1, pos is tb.pos ]
}

create parse_for_each using toks, p {
    make vtok be toks[p plus 2]
    make c be parse_expr with toks, p plus 4
    make q changeable c.pos
    make tb be parse_block with toks, q
    make r2 be map [ kind is "for", var is vtok.value, iter is c.node, body is tb.block ]
    give map [ stmt is r2, pos is tb.pos ]
}

create parse_repeat_count using toks, p {
    make prim be parse_primary with toks, p
    make l changeable prim.node
    make n changeable prim.pos
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", code is 0, line is 0 ]
    while go is 1 {
        when n is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[n]
            when tok.type is 0 {
                when (str_eq with tok.value, "plus") is 1 {
                    make r be parse_primary with toks, n plus 1
                    make rn be r.node
                    change n to r.pos
                    change l to map [ kind is "binop", op is "plus", left is l, right is rn ]
                }
                otherwise {
                    when (str_eq with tok.value, "minus") is 1 {
                        make r be parse_primary with toks, n plus 1
                        make rn be r.node
                        change n to r.pos
                        change l to map [ kind is "binop", op is "minus", left is l, right is rn ]
                    }
                    otherwise {
                        change go to 0
                    }
                }
            }
            otherwise {
                when tok.type is 3 {
                    when tok.code is 43 {
                        make r be parse_primary with toks, n plus 1
                        make rn be r.node
                        change n to r.pos
                        change l to map [ kind is "binop", op is "+", left is l, right is rn ]
                    }
                    otherwise {
                        when tok.code is 45 {
                            make r be parse_primary with toks, n plus 1
                            make rn be r.node
                            change n to r.pos
                            change l to map [ kind is "binop", op is "-", left is l, right is rn ]
                        }
                        otherwise {
                            change go to 0
                        }
                    }
                }
                otherwise {
                    change go to 0
                }
            }
        }
    }
    give map [ node is l, pos is n ]
}

create parse_repeat using toks, p {
    make c be parse_repeat_count with toks, p plus 1
    make q changeable c.pos
    make tb be parse_block with toks, q plus 1
    make r1 be map [ kind is "repeat", count is c.node, body is tb.block ]
    give map [ stmt is r1, pos is tb.pos ]
}

create parse_attempt using toks, p {
    make tb be parse_block with toks, p plus 1
    make q changeable tb.pos
    make L be len with toks
    make t2 changeable map [ type is 0, value is "", code is 0, line is 0 ]
    make os changeable 1
    while os is 1 {
        when q is at least L {
            change os to 0
        }
        otherwise {
            change t2 to toks[q]
            when t2.type is 4 {
                change q to q plus 1
            }
            otherwise {
                change os to 0
            }
        }
    }
    make eb changeable []
    make evn changeable ""
    when q is below L {
        change t2 to toks[q]
        when t2.type is 0 {
            when (str_eq with t2.value, "recover") is 1 {
                make ev be toks[q plus 1]
                make eb2 be parse_block with toks, q plus 2
                change q to eb2.pos
                change eb to eb2.block
                change evn to ev.value
            }
        }
    }
    make a1 be map [ kind is "attempt", body is tb.block, handler is eb, errvar is evn ]
    give map [ stmt is a1, pos is q ]
}

create parse_block using toks, p {
    make stmts be []
    make q changeable p plus 1
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", code is 0, line is 0 ]
    while go is 1 {
        when q is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[q]
            when tok.type is 4 {
                change q to q plus 1
            }
            otherwise {
                when tok.code is 125 {
                    give map [ block is stmts, pos is q plus 1 ]
                }
                otherwise {
                    when tok.type is 5 {
                        change go to 0
                    }
                    otherwise {
                        make r be parse_statement with toks, q
                        add r.stmt to stmts
                        change q to r.pos
                    }
                }
            }
        }
    }
    give map [ block is stmts, pos is q ]
}

create parse_create using toks, p {
    make ntok be toks[p plus 1]
    make params be []
    make q changeable p plus 2
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", code is 0, line is 0 ]
    when q is below L {
        change tok to toks[q]
        when (str_eq with tok.value, "using") is 1 {
            change q to q plus 1
        }
    }
    while go is 1 {
        when q is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[q]
            when tok.code is 123 {
                make b be parse_block with toks, q
                make f1 be map [ kind is "function", name is ntok.value, params is params, body is b.block ]
                give map [ stmt is f1, pos is b.pos ]
            }
            otherwise {
                when tok.type is 0 {
                    add tok.value to params
                    change q to q plus 1
                }
                otherwise {
                    when tok.type is 3 {
                        change q to q plus 1
                    }
                    otherwise {
                        change go to 0
                    }
                }
            }
        }
    }
    make f2 be map [ kind is "err", name is "" ]
    give map [ stmt is f2, pos is p plus 1 ]
}

create parse_when using toks, p {
    make c be parse_expr with toks, p plus 1
    make q changeable c.pos
    make tb be parse_block with toks, q
    make eb changeable []
    make q2 changeable tb.pos
    make L be len with toks
    make t2 changeable map [ type is 0, value is "", code is 0, line is 0 ]
    make os changeable 1
    while os is 1 {
        when q2 is at least L {
            change os to 0
        }
        otherwise {
            change t2 to toks[q2]
            when t2.type is 4 {
                change q2 to q2 plus 1
            }
            otherwise {
                change os to 0
            }
        }
    }
    when q2 is below L {
        change t2 to toks[q2]
        when t2.type is 0 {
            when (str_eq with t2.value, "otherwise") is 1 {
                make eb2 be parse_block with toks, q2 plus 1
                change q2 to eb2.pos
                change eb to eb2.block
            }
        }
    }
    make w1 be map [ kind is "when", cond is c.node, then is tb.block, els is eb ]
    give map [ stmt is w1, pos is q2 ]
}

create parse_statement using toks, p {
    make tok be toks[p]
    when tok.type is 0 {
        when (str_eq with tok.value, "make") is 1 {
            make ntok be toks[p plus 1]
            make r be parse_expr with toks, p plus 3
            make m1 be map [ kind is "make", name is ntok.value, value is r.node ]
            give map [ stmt is m1, pos is r.pos ]
        }
        otherwise {
            when (str_eq with tok.value, "show") is 1 {
                make r be parse_expr with toks, p plus 1
                make m2 be map [ kind is "show", expr is r.node ]
                give map [ stmt is m2, pos is r.pos ]
            }
            otherwise {
                when (str_eq with tok.value, "create") is 1 {
                    give parse_create with toks, p
                }
                otherwise {
                    when (str_eq with tok.value, "give") is 1 {
                        make r be parse_expr with toks, p plus 1
                        make m5 be map [ kind is "give", expr is r.node ]
                        give map [ stmt is m5, pos is r.pos ]
                    }
                    otherwise {
                        when (str_eq with tok.value, "when") is 1 {
                            give parse_when with toks, p
                        }
                        otherwise {
                            when (str_eq with tok.value, "while") is 1 {
                                give parse_while with toks, p
                            }
                            otherwise {
                                when (str_eq with tok.value, "for") is 1 {
                                    give parse_for_each with toks, p
                                }
                                otherwise {
                                    when (str_eq with tok.value, "repeat") is 1 {
                                        give parse_repeat with toks, p
                                    }
                                    otherwise {
                                        when (str_eq with tok.value, "change") is 1 {
                                            make ntok be toks[p plus 1]
                                            make r be parse_expr with toks, p plus 3
                                            make mch be map [ kind is "change", name is ntok.value, value is r.node ]
                                            give map [ stmt is mch, pos is r.pos ]
                                        }
                                        otherwise {
                                            when (str_eq with tok.value, "stop") is 1 {
                                                make ms be map [ kind is "stop" ]
                                                give map [ stmt is ms, pos is p plus 1 ]
                                            }
                                            otherwise {
                                                when (str_eq with tok.value, "skip") is 1 {
                                                    make mk be map [ kind is "skip" ]
                                                    give map [ stmt is mk, pos is p plus 1 ]
                                                }
                                                otherwise {
                                                    when (str_eq with tok.value, "attempt") is 1 {
                                                        give parse_attempt with toks, p
                                                    }
                                                    otherwise {
                                                        make m3 be map [ kind is "err", name is "" ]
                                                        give map [ stmt is m3, pos is p plus 1 ]
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    otherwise {
        make m4 be map [ kind is "err", name is "" ]
        give map [ stmt is m4, pos is p plus 1 ]
    }
}

create parse_program using toks {
    make stmts be []
    make p changeable 0
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", code is 0, line is 0 ]
    while go is 1 {
        when p is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[p]
            when tok.type is 4 {
                change p to p plus 1
            }
            otherwise {
                when tok.type is 5 {
                    change go to 0
                }
                otherwise {
                    make r be parse_statement with toks, p
                    add r.stmt to stmts
                    change p to r.pos
                }
            }
        }
    }
    give stmts
}
create index_of using lst, name {
    make i changeable 0
    for each n in lst {
        change i to i plus 1
        when (str_eq with n, name) is 1 {
            give i
        }
    }
    give 0
}

create setcc_for using op {
    when (str_eq with op, "is") is 1 {
        give "e"
    }
    otherwise {
        when (str_eq with op, "is not") is 1 {
            give "ne"
        }
        otherwise {
            when (str_eq with op, "is below") is 1 {
                give "l"
            }
            otherwise {
                when (str_eq with op, "is above") is 1 {
                    give "g"
                }
                otherwise {
                    when (str_eq with op, "is at most") is 1 {
                        give "le"
                    }
                    otherwise {
                        give "ge"
                    }
                }
            }
        }
    }
}

create gen_expr using node, vars {
    when (str_eq with node.kind, "int") is 1 {
        make v be to_string with node.value
        make p1 be concat with "  mov $", v
        give concat with p1, ", %rax\n"
    }
    otherwise {
        when (str_eq with node.kind, "id") is 1 {
            make idx be index_of with vars, node.value
            when idx is 0 {
                give "  xor %eax, %eax\n"
            }
            otherwise {
                make off be to_string with idx times 8
                make p2 be concat with "  mov -", off
                give concat with p2, "(%rbp), %rax\n"
            }
        }
        otherwise {
            when (str_eq with node.kind, "call") is 1 {
                when (str_eq with node.name, "len") is 1 {
                    make arglist be node.args
                    make a0 be arglist[0]
                    make ae be gen_expr with a0, vars
                    give concat with ae, "  mov -8(%rax), %rax\n"
                }
                otherwise {
                    make arglist be node.args
                    make code changeable ""
                    when (str_eq with node.name, "at") is 1 {
                        make a0 be arglist[0]
                        make a1 be arglist[1]
                        make e0 be gen_expr with a0, vars
                        make e1 be gen_expr with a1, vars
                        make c1 be concat with e0, "  push %rax\n"
                        make c2 be concat with c1, e1
                        make c3 be concat with c2, "  mov %rax, %rcx\n  pop %rax\n  lea 8(%rax,%rcx,8), %rax\n  mov (%rax), %rax\n"
                        give c3
                    }
                    otherwise {
                        when (str_eq with node.name, "appended") is 1 {
                            make a0 be arglist[0]
                            make a1 be arglist[1]
                            make e0 be gen_expr with a0, vars
                            make e1 be gen_expr with a1, vars
                            make c1 be concat with e0, "  push %rax\n"
                            make c2 be concat with c1, e1
                            make c3 be concat with c2, "  mov %rax, %rdx\n  pop %rax\n  mov %rax, %rbx\n  mov -8(%rbx), %rcx\n  lea 1(%rcx), %r8\n  mov %r8, %rdi\n  call alloc_list\n  mov %rax, %r9\n  mov %r8, -8(%r9)\n  xor %r10, %r10\ncp_loop:\n  cmp %r10, %rcx\n  jle cp_done\n  mov 8(%rbx,%r10,8), %r11\n  mov %r11, 8(%r9,%r10,8)\n  inc %r10\n  jmp cp_loop\ncp_done:\n  mov %rdx, 8(%r9,%rcx,8)\n  mov %r9, %rax\n"
                            give c3
                        }
                        otherwise {
                            for each ar in arglist {
                                make ae be gen_expr with ar, vars
                                change code to concat with code, ae
                                change code to concat with code, "  push %rax\n"
                            }
                            make c1 be concat with code, "  call "
                            make nm be concat with node.name, "\n"
                            give concat with c1, nm
                        }
                    }
                    make c1 be concat with code, "  call "
                    make nm be concat with node.name, "\n"
                    give concat with c1, nm
                }
            }
            otherwise {
                when (str_eq with node.kind, "list") is 1 {
                    make items be node.items
                    make n be len with items
                    make code changeable ""
                    for each it in items {
                        make ie be gen_expr with it, vars
                        change code to concat with code, ie
                        change code to concat with code, "  push %rax\n"
                    }
                    make nstr be to_string with n
                    make c1 be concat with code, "  mov $"
                    make c2 be concat with c1, nstr
                    make c3 be concat with c2, ", %rdi\n  call alloc_list\n"
                    make c4 changeable concat with c3, "  mov %rax, %r11\n"
                    make li changeable 0
                    make c5 changeable ""
                    make loff changeable ""
                    while li is below n {
                        change c5 to concat with c4, "  pop %rax\n  mov %rax, "
                        change loff to to_string with 8 plus (n minus 1 minus li) times 8
                        change c5 to concat with c5, loff
                        change c5 to concat with c5, "(%r11)\n"
                        change c4 to c5
                        change li to li plus 1
                    }
                    give concat with c4, "  mov %r11, %rax\n"
                }
                otherwise {
                    when (str_eq with node.kind, "binop") is 1 {
                    make ls be gen_expr with node.left, vars
                    make rs be gen_expr with node.right, vars
                    make l2 be concat with ls, "  push %rax\n"
                    make l3 be concat with l2, rs
                    make l4 be concat with l3, "  mov %rax, %rdx\n"
                    make l5 be concat with l4, "  pop %rax\n"
                    when (str_eq with node.op, "plus") is 1 {
                        make a1 be concat with l5, "  add %rdx, %rax\n"
                        give a1
                    }
                    otherwise {
                        when (str_eq with node.op, "minus") is 1 {
                            make a2 be concat with l5, "  sub %rdx, %rax\n"
                            give a2
                        }
                        otherwise {
                            when (str_eq with node.op, "times") is 1 {
                                make a3 be concat with l5, "  imul %rdx, %rax\n"
                                give a3
                            }
                            otherwise {
                                make a4 be concat with l5, "  mov %rdx, %rcx\n  cqo\n  idiv %rcx\n"
                                give a4
                            }
                        }
                    }
                }
                otherwise {
                    when (str_eq with node.kind, "cmp") is 1 {
                        make cl be gen_expr with node.left, vars
                        make cr be gen_expr with node.right, vars
                        make c2 be concat with cl, "  push %rax\n"
                        make c3 be concat with c2, cr
                        make c4 be concat with c3, "  mov %rax, %rdx\n"
                        make c5 be concat with c4, "  pop %rax\n"
                        make c6 be concat with c5, "  cmp %rdx, %rax\n"
                        make cc be setcc_for with node.op
                        make c7 be concat with c6, "  set"
                        make c8 be concat with c7, cc
                        make c9 be concat with c8, " %al\n"
                        give concat with c9, "  movzbl %al, %eax\n"
                    }
                    otherwise {
                        give "  xor %eax, %eax\n"
                    }
                }
            }
        }
    }
}

create gen_show using expr, vars {
    make e be gen_expr with expr, vars
    make e2 be concat with e, "  mov %rax, %rdi\n"
    make s1 be concat with e2, "  call print_int\n"
    give concat with s1, "  mov $1, %rax\n  mov $1, %rdi\n  lea newline(%rip), %rsi\n  mov $1, %rdx\n  syscall\n"
}

create gen_block using stmts, vars, ctr, retlabel {
    make asm changeable ""
    make c changeable ctr
    for each st in stmts {
        when (str_eq with st.kind, "show") is 1 {
            make gs be gen_show with st.expr, vars
            change asm to concat with asm, gs
        }
        otherwise {
            when (str_eq with st.kind, "make") is 1 {
                make ve be gen_expr with st.value, vars
                make idx changeable index_of with vars, st.name
                when idx is 0 {
                    add st.name to vars
                    change idx to len with vars
                }
                make off be to_string with idx times 8
                make st1 be concat with ve, "  mov %rax, -"
                make st2 be concat with st1, off
                make st3 be concat with st2, "(%rbp)\n"
                change asm to concat with asm, st3
            }
            otherwise {
                when (str_eq with st.kind, "change") is 1 {
                    make ve be gen_expr with st.value, vars
                    make idx changeable index_of with vars, st.name
                    when idx is 0 {
                        change idx to 1
                    }
                    make off be to_string with idx times 8
                    make st1 be concat with ve, "  mov %rax, -"
                    make st2 be concat with st1, off
                    make st3 be concat with st2, "(%rbp)\n"
                    change asm to concat with asm, st3
                }
                otherwise {
                    when (str_eq with st.kind, "give") is 1 {
                        make ve be gen_expr with st.expr, vars
                        make st1 be concat with ve, "  jmp "
                        make st2 be concat with retlabel, "\n"
                        change asm to concat with asm, concat with st1, st2
                    }
                    otherwise {
                        when (str_eq with st.kind, "when") is 1 {
                            make cc2 be to_string with c
                            change c to c plus 1
                            make ce be to_string with c
                            change c to c plus 1
                            make cnd be gen_expr with st.cond, vars
                            make c1 be concat with cnd, "  test %rax, %rax\n  jz .L"
                            make c2 be concat with c1, cc2
                            make c3 be concat with c2, "\n"
                            make tb be gen_block with st.then, vars, c, retlabel
                            make c4 be concat with c3, tb.asm
                            make c5 be concat with c4, "  jmp .L"
                            make c6 be concat with c5, ce
                            make c7 be concat with c6, "\n.L"
                            make c8 be concat with c7, cc2
                            make c9 be concat with c8, ":\n"
                            make eb be gen_block with st.els, vars, tb.count, retlabel
                            make c10 be concat with c9, eb.asm
                            make c11 be concat with c10, ".L"
                            make c12 be concat with c11, ce
                            make c13 be concat with c12, ":\n"
                            change asm to concat with asm, c13
                            change c to eb.count
                        }
                        otherwise {
                            when (str_eq with st.kind, "repeat") is 1 {
                                make ctop be to_string with c
                                change c to c plus 1
                                make cend be to_string with c
                                change c to c plus 1
                                make hname be concat with "rept", ctop
                                make idx changeable index_of with vars, hname
                                when idx is 0 {
                                    add hname to vars
                                    change idx to len with vars
                                }
                                make off be to_string with idx times 8
                                make cnd be gen_expr with st.count, vars
                                make c1 be concat with cnd, "  mov %rax, -"
                                make c2 be concat with c1, off
                                make c3 be concat with c2, "(%rbp)\n.L"
                                make c4 be concat with c3, ctop
                                make c5 be concat with c4, ":\n  mov -"
                                make c6 be concat with c5, off
                                make c7 be concat with c6, "(%rbp), %rax\n  test %rax, %rax\n  jz .L"
                                make c8 be concat with c7, cend
                                make c9 be concat with c8, "\n"
                                make tb be gen_block with st.body, vars, c, retlabel
                                make c10 be concat with c9, tb.asm
                                make c11 be concat with c10, "  mov -"
                                make c12 be concat with c11, off
                                make c13 be concat with c12, "(%rbp), %rax\n  sub $1, %rax\n  mov %rax, -"
                                make c14 be concat with c13, off
                                make c15 be concat with c14, "(%rbp)\n  jmp .L"
                                make c16 be concat with c15, ctop
                                make c17 be concat with c16, "\n.L"
                                make c18 be concat with c17, cend
                                make c19 be concat with c18, ":\n"
                                change asm to concat with asm, c19
                                change c to tb.count
                            }
                            otherwise {
                                when (str_eq with st.kind, "while") is 1 {
                                    make ctop be to_string with c
                                    change c to c plus 1
                                    make cend be to_string with c
                                    change c to c plus 1
                                    make cnd be gen_expr with st.cond, vars
                                    make c1 be concat with ".L", ctop
                                    make c2 be concat with c1, ":\n"
                                    make c3 be concat with c2, cnd
                                    make c4 be concat with c3, "  test %rax, %rax\n  jz .L"
                                    make c5 be concat with c4, cend
                                    make c6 be concat with c5, "\n"
                                    make tb be gen_block with st.body, vars, c, retlabel
                                    make c7 be concat with c6, tb.asm
                                    make c8 be concat with c7, "  jmp .L"
                                    make c9 be concat with c8, ctop
                                    make c10 be concat with c9, "\n.L"
                                    make c11 be concat with c10, cend
                                    make c12 be concat with c11, ":\n"
                                    change asm to concat with asm, c12
                                    change c to tb.count
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    give map [ asm is asm, count is c ]
}

create gen_function using fn, ctr {
    make vars changeable fn.params
    make r be gen_block with fn.body, vars, ctr, concat with ".Lret_", fn.name
    make p0 be concat with fn.name, ":\n  push %rbp\n  mov %rsp, %rbp\n  sub $64, %rsp\n"
    make paramcopy changeable ""
    make i changeable 0
    make np be len with fn.params
    while i is below np {
        make off be to_string with (i plus 1) times 8
        make src be to_string with 16 plus i times 8
        make pc1 be concat with "  mov ", src
        make pc2 be concat with pc1, "(%rbp), %rax\n  mov %rax, -"
        make pc3 be concat with pc2, off
        make pc4 be concat with pc3, "(%rbp)\n"
        change paramcopy to concat with paramcopy, pc4
        change i to i plus 1
    }
    make body be concat with p0, paramcopy
    make body2 be concat with body, r.asm
    make ep be concat with ".Lret_", fn.name
    make ep2 be concat with ep, ":\n  mov %rbp, %rsp\n  pop %rbp\n  ret\n"
    make full be concat with body2, ep2
    give map [ asm is full, count is r.count ]
}

create gen_program using progs {
    make main_stmts be []
    make fns be []
    for each st in progs {
        when (str_eq with st.kind, "function") is 1 {
            add st to fns
        }
        otherwise {
            add st to main_stmts
        }
    }
    make rmain be gen_block with main_stmts, [], 0, ".Lmainret"
    make fcode changeable ""
    make fall changeable rmain.count
    for each fn in fns {
        make fr be gen_function with fn, fall
        change fcode to concat with fcode, fr.asm
        change fall to fr.count
    }
    make heap be ".data\n.align 8\nheap:\n  .zero 65536\nheap_top:\n  .quad heap\n.text\n"
    make als be "alloc_list:\n  push %rbp\n  mov %rsp, %rbp\n  mov %rdi, %r8\n  mov heap_top(%rip), %r9\n  lea (%r9,%r8,8), %r10\n  lea 8(%r10), %r10\n  mov %r10, heap_top(%rip)\n  mov %r8, (%r9)\n  lea 8(%r9), %rax\n  mov %rbp, %rsp\n  pop %rbp\n  ret\n"
    make rt be "print_int:\n  push %rbp\n  mov %rsp, %rbp\n  sub $48, %rsp\n  mov %rdi, %rax\n  xor %r9, %r9\n  test %rax, %rax\n  jns pi_prep\n  mov $1, %r9\n  neg %rax\npi_prep:\n  mov $10, %rcx\n  lea 47(%rsp), %r8\n  movb $0, (%r8)\nprint_loop:\n  xor %rdx, %rdx\n  div %rcx\n  add $'0', %dl\n  dec %r8\n  mov %dl, (%r8)\n  test %rax, %rax\n  jnz print_loop\n  test %r9, %r9\n  jz pi_nosign\n  dec %r8\n  movb $'-', (%r8)\npi_nosign:\n  mov %r8, %rsi\n  lea 47(%rsp), %rdx\n  sub %r8, %rdx\n  mov $1, %rax\n  mov $1, %rdi\n  syscall\n  mov %rbp, %rsp\n  pop %rbp\n  ret\n"
    make head be ".text\n.globl _start\n_start:\n  call main\n  mov $60, %rax\n  xor %rdi, %rdi\n  syscall\nmain:\n  push %rbp\n  mov %rsp, %rbp\n  sub $64, %rsp\n"
    make tail be ".Lmainret:\n  mov %rbp, %rsp\n  pop %rbp\n  ret\n.data\nnewline:\n  .byte 10\n.text\n"
    make hc be concat with head, rmain.asm
    make hc2 be concat with hc, tail
    make hc3 be concat with hc2, fcode
    make hc4 be concat with hc3, heap
    make hc5 be concat with hc4, als
    give concat with hc5, rt
}

create main {
    make src be "make a be [10, 20, 30]\nshow at with a, 1\nshow at with a, 2\nmake b be appended with a, 99\nshow len with b\nshow at with b, 3\n"
    make toks be lex with src
    make progs be parse_program with toks
    make asm be gen_program with progs
    show asm
}

