# bootstrap/lexer.nuru
# Stage 1 of the self-hosted compiler: a tokenizer for Nuru source.
# Token types: 0=identifier, 1=integer, 2=string, 3=punctuation,
#              4=newline, 5=eof. Each token is a map with type/value/line.

create is_digit using c {
    when c is at least 48 {
        when c is at most 57 {
            give 1
        }
    }
    give 0
}

create is_alpha using c {
    when c is at least 65 {
        when c is at most 90 {
            give 1
        }
    }
    when c is at least 97 {
        when c is at most 122 {
            give 1
        }
    }
    when c is 95 {
        give 1
    }
    give 0
}

create make_token using t, v, ln {
    give map [ type is t, value is v, line is ln ]
}

create lex using src {
    make tokens be []
    make i changeable 0
    make n be len with src
    make line changeable 1

    while i is below n {
        make c be ord with substring with src, i, i plus 1

        when c is 10 {
            add make_token with 4, "", line to tokens
            change line to line plus 1
            change i to i plus 1
        }
        otherwise {
            when c is 32 {
                change i to i plus 1
            }
            otherwise {
                when c is 9 {
                    change i to i plus 1
                }
                otherwise {
                    when (is_digit with c) is 1 {
                        make start be i
                        while i is below n {
                            make c2 be ord with substring with src, i, i plus 1
                            when (is_digit with c2) is 1 {
                                change i to i plus 1
                            }
                            otherwise {
                                stop
                            }
                        }
                        make sv_int be substring with src, start, i
                        make nv be to_number with sv_int
                        add make_token with 1, nv, line to tokens
                    }
                    otherwise {
                        when (is_alpha with c) is 1 {
                            make start be i
                            while i is below n {
                                make c2 be ord with substring with src, i, i plus 1
                                when (is_alpha with c2) is 1 {
                                    change i to i plus 1
                                }
                                otherwise {
                                    stop
                                }
                            }
                            make sv_id be substring with src, start, i
                            add make_token with 0, sv_id, line to tokens
                        }
                        otherwise {
                            when c is 34 {
                                make start be i
                                change i to i plus 1
                                make kg changeable 1
                                while kg is 1 {
                                    when i is at least n {
                                        change kg to 0
                                    }
                                    otherwise {
                                        make c2 be ord with substring with src, i, i plus 1
                                        when c2 is 34 {
                                            change i to i plus 1
                                            change kg to 0
                                        }
                                        otherwise {
                                            change i to i plus 1
                                        }
                                    }
                                }
                                make sv_str be substring with src, start, i
                                add make_token with 2, sv_str, line to tokens
                            }
                            otherwise {
                                make cv_punct be chr with c
                                add map [ type is 3, value is cv_punct, code is c, line is line ] to tokens
                                change i to i plus 1
                            }
                        }
                    }
                }
            }
        }
    }

    add make_token with 5, "", line to tokens
    give tokens
}

# bootstrap/parser_expr.nuru
# Stage 2 (subset): a recursive-descent expression parser written in Nuru.
# Parses integer/identifier primaries and + - * / with parentheses into a
# nested map-based AST (kind: "int" / "id" / "binop").

create parse_primary using toks, p {
    make tok be toks[p]
    when tok.type is 1 {
        give map [ node is map [ kind is "int", value is tok.value ], pos is p plus 1 ]
    }
    otherwise {
        when tok.type is 0 {
            give map [ node is map [ kind is "id", value is tok.value ], pos is p plus 1 ]
        }
        otherwise {
            when tok.type is 3 {
                when tok.code is 40 {
                    make r be parse_expr with toks, p plus 1
                    give map [ node is r.node, pos is r.pos plus 1 ]
                }
                otherwise {
                    give map [ node is map [ kind is "err", value is "" ], pos is p plus 1 ]
                }
            }
            otherwise {
                give map [ node is map [ kind is "err", value is "" ], pos is p plus 1 ]
            }
        }
    }
}

create parse_mul using toks, p {
    make prim be parse_primary with toks, p
    make l changeable prim.node
    make n changeable prim.pos
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", line is 0 ]
    while go is 1 {
        when n is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[n]
            when tok.type is 3 {
                when tok.code is 42 {
                    make r be parse_primary with toks, n plus 1
                    make rn be r.node
                    change n to r.pos
                    change l to map [ kind is "binop", op is "*", left is l, right is rn ]
                }
                otherwise {
                    when tok.code is 47 {
                        make r be parse_primary with toks, n plus 1
                        make rn be r.node
                        change n to r.pos
                        change l to map [ kind is "binop", op is "/", left is l, right is rn ]
                    }
                    otherwise {
                        change go to 0
                    }
                }
            }
            otherwise {
                change go to 0
            }
        }
    }
    give map [ node is l, pos is n ]
}

create parse_add using toks, p {
    make prim be parse_mul with toks, p
    make l changeable prim.node
    make n changeable prim.pos
    make L be len with toks
    make go changeable 1
    make tok changeable map [ type is 0, value is "", line is 0 ]
    while go is 1 {
        when n is at least L {
            change go to 0
        }
        otherwise {
            change tok to toks[n]
            when tok.code is 43 {
                make r be parse_mul with toks, n plus 1
                make rn be r.node
                change n to r.pos
                change l to map [ kind is "binop", op is "+", left is l, right is rn ]
            }
            otherwise {
                when tok.code is 45 {
                    make r be parse_mul with toks, n plus 1
                    make rn be r.node
                    change n to r.pos
                    change l to map [ kind is "binop", op is "-", left is l, right is rn ]
                }
                otherwise {
                    change go to 0
                }
            }
        }
    }
    give map [ node is l, pos is n ]
}

create parse_expr using toks, p {
    give parse_add with toks, p
}

create show_ast using node, depth {
    make indent changeable ""
    make i changeable 0
    while i is below depth {
        change indent to concat with indent, "  "
        change i to i plus 1
    }
    make line be concat with indent, node.kind
    show line
    when node.kind is "binop" {
        make t1 be concat with indent, "op="
        make t2 be concat with t1, node.op
        show t2
        show_ast with node.left, depth plus 1
        show_ast with node.right, depth plus 1
    }
    otherwise {
        when node.kind is "id" {
            make t3 be concat with indent, node.value
            show t3
        }
        otherwise {
            when node.kind is "int" {
                make t4 be concat with indent, to_string with node.value
                show t4
            }
        }
    }
}

create main {
    make src be "3 + 4 * (x - 1)"
    make toks be lex with src
    make res be parse_expr with toks, 0
    show_ast with res.node, 0
}
